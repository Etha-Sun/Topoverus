+        else:
+            if verbose:
+                print(f"[Docker API] Error response: {response.status_code} - {response.text}")
+            # Return failure result
+            return KernelExecResult(
+                compiled=False,
+                executable=False,
+                correctness=False,
+                metadata={"api_error": f"HTTP {response.status_code}: {response.text}"}
+            )
+            
+    except requests.exceptions.Timeout:
+        if verbose:
+            print(f"[Docker API] Request timeout after {timeout} seconds")
+        return KernelExecResult(
+            compiled=False,
+            executable=False,
+            correctness=False,
+            metadata={"api_error": f"Request timeout after {timeout} seconds"}
+        )
+        
+    except requests.exceptions.ConnectionError:
+        if verbose:
+            print(f"[Docker API] Connection error to {api_url}")
+        return KernelExecResult(
+            compiled=False,
+            executable=False,
+            correctness=False,
+            metadata={"api_error": f"Connection error to {api_url}"}
+        )
+        
+    except Exception as e:
+        if verbose:
+            print(f"[Docker API] Unexpected error: {e}")
+        return KernelExecResult(
+            compiled=False,
+            executable=False,
+            correctness=False,
+            metadata={"api_error": f"Unexpected error: {str(e)}"}
+        )
+
+class KernelBenchRewardModel:
+    """
+    Reward model for KernelBench evaluation results.
+    
+    This reward function computes scores based on KernelBench evaluation results,
+    considering compilation success, correctness, and performance (speedup).
+    """
+    
+    def __init__(
+        self,
+        pretrain_compilation_weight: float = 0.5,
+        finetune_compilation_weight: float = 0.1,
+        pretrain_correctness_weight: float = 1.3, 
+        finetune_correctness_weight: float = 0.3, 
+        pretrain_performance_weight: float = 0,
+        finetune_performance_weight: float = 1,
+        baseline_time_file: str = "benchmark/KernelBench/results/timing/L40S_vegeta/baseline_time_torch.json",
+        docker_api_url: str = f"http://localhost:9000",
+        docker_api_timeout: int = 300,
+        pretrain_steps: int = 0
+    ):
+        """
+        Initialize the KernelBench reward model.
+        
+        Args:
+            compilation_weight: Weight for compilation success (0-1)
+            correctness_weight: Weight for correctness (0-1) 
+            performance_weight: Weight for performance/speedup (0-1)
+            baseline_time_file: Path to baseline timing file
+            docker_api_url: URL of the Docker API service
+            docker_api_timeout: Request timeout in seconds
+        """
+            
+        self.code_language_types = ["python", "cpp"]
+        self.pretrain_compilation_weight = pretrain_compilation_weight
+        self.pretrain_correctness_weight = pretrain_correctness_weight
+        self.pretrain_performance_weight = pretrain_performance_weight
+        self.finetune_compilation_weight = finetune_compilation_weight
+        self.finetune_correctness_weight = finetune_correctness_weight
+        self.finetune_performance_weight = finetune_performance_weight
+        self.compilation_weight = self.pretrain_compilation_weight
+        self.correctness_weight = self.pretrain_correctness_weight
+        self.performance_weight = self.pretrain_performance_weight
+        self.pretrain_steps = pretrain_steps
+        self.baseline_time_file = baseline_time_file
+        self.baseline_times = self._load_baseline_times() if baseline_time_file else {}
+        self.docker_api_url = docker_api_url
+        self.docker_api_timeout = docker_api_timeout
+
+    def _load_baseline_times(self) -> Dict[str, float]:
+        """Load baseline timing data from file."""
+        if not os.path.exists(self.baseline_time_file):
+            print(f"Warning: Baseline time file {self.baseline_time_file} not found. Current working directory: {os.getcwd()}. Relative path: {os.path.relpath(self.baseline_time_file, os.getcwd())}.")
+            return {}
+            
+        try:
+            with open(self.baseline_time_file, 'r') as f:
+                baseline_data = json.load(f)
+            print(baseline_data)
+            return baseline_data
+        except Exception as e:
+            print(f"Error loading baseline times: {e}")
+            return {}
+
+    def post_process(self, output: str) -> str:
+        """Default post-processing for generated code from KernelBench."""
+        if not isinstance(output, str):
+            raise ValueError("KernelBenchRewardModel Post-process does not support list of completions")
+        
+        trimmed = output.strip()
+
+        # Extracting the first occurrence of content between backticks
+        code_match = re.search(r"```(.*?)```", trimmed, re.DOTALL)
+
+        if code_match:
+            # Strip leading and trailing whitespace from the extracted code
+            code = code_match.group(1).strip()
+
+            # depends on code_language_type: cpp, python, etc.
+            # sometimes the block of code is ```cpp ... ``` instead of ``` ... ```
+            # in this case strip the cpp out
+            for code_type in self.code_language_types:
+                if code.startswith(code_type):
+                    code = code[len(code_type) :].strip()
+
+            return code
+
+        return None
+    
+    def _set_weights(self, current_step: int):
+        """
+        Set weights based on current step.
+        
+        Args:
+            current_step: Current step
+        """
+        if current_step < self.pretrain_steps:
+            self.compilation_weight = self.pretrain_compilation_weight
+            self.correctness_weight = self.pretrain_correctness_weight
+            self.performance_weight = self.pretrain_performance_weight
+        else:
+            self.compilation_weight = self.finetune_compilation_weight
+            self.correctness_weight = self.finetune_correctness_weight
+            self.performance_weight = self.finetune_performance_weight
+
+    def _compute_compilation_reward(self, compiled: bool) -> float:
+        """Compute reward for compilation success."""
+        return 1.0 if compiled else 0.0
+
+    def _weighted_compilation_reward(self, compiled: bool) -> float:
+        """
+        Compute weighted compilation reward.
+        
+        Args:
+            compiled: Whether the kernel compiled successfully
+            current_step: Current step
+        """
+        return self.compilation_weight * self._compute_compilation_reward(compiled)
+
+    def _compute_correctness_reward(self, correctness: bool) -> float:
+        """Compute reward for correctness."""
+        return 1.0 if correctness else 0.0
+
+    def _weighted_correctness_reward(self, correctness: bool) -> float:
+        """
+        Compute weighted correctness reward.
+        
+        Args:
+            correctness: Whether the kernel produces correct output
+            current_step: Current step
+        """
+        return self.correctness_weight * self._compute_correctness_reward(correctness)
+
+    def _compute_performance_reward(self, runtime: float, baseline_time: float = None) -> float:
+        """
+        Compute reward for performance based on speedup.
+        
+        Args:
+            runtime: Execution time of the generated kernel (ms)
+            baseline_time: Baseline execution time (ms)
+            
+        Returns:
+            Speedup
+        """
+        if runtime <= 0 or baseline_time is None or baseline_time <= 0:
+            return 0.0
+            
+        speedup = baseline_time / runtime
+        return speedup
+
+    def _weighted_performance_reward(self, runtime: float, baseline_time: float = None) -> float:
+        """
+        Compute weighted performance reward.
+        
+        Args:
+            runtime: Execution time of the kernel (ms)
+            baseline_time: Baseline execution time (ms)
+        """
+        return self.performance_weight * self._compute_performance_reward(runtime, baseline_time)
+    
+    def _compute_combined_reward(
+        self, 
+        compiled: bool, 
+        correctness: bool, 
+        runtime: float, 
+        baseline_time: float = None
+    ) -> float:
+        """
+        Compute combined reward from all factors.
+        
+        Args:
+            compiled: Whether the kernel compiled successfully
+            correctness: Whether the kernel produces correct output
+            runtime: Execution time of the kernel (ms)
+            baseline_time: Baseline execution time (ms)
+            
+        Returns:
+            Combined reward score
+        """
+        # Compute individual rewards
+        comp_reward = self._compute_compilation_reward(compiled)
+        corr_reward = self._compute_correctness_reward(correctness)
+        perf_reward = self._compute_performance_reward(runtime, baseline_time)
+        
+        # Weighted combination
+        combined_reward = (
+            self.compilation_weight * comp_reward +
+            self.correctness_weight * corr_reward +
+            self.performance_weight * perf_reward
+        )
+        
+        return combined_reward
+
+    def __call__(self, completions: str, ground_truth: str, extra_info: dict = None, **kwargs) -> torch.Tensor:
+        """
+        Compute rewards for a batch of completions.
+        
+        Args:
+            completions: Generated code completions
+            ground_truth: Ground truth code (original model)
+            extra_info: Extra information including task_id
+            **kwargs: Additional arguments
+            
+        Returns:
+            Dictionary with reward score and extra info
+        """
+        print(f"[Docker API] Using KernelBench Docker API at {self.docker_api_url}")
+        
+        task_id = extra_info.get("task_id", "unknown") if extra_info else "unknown"
+        level = extra_info.get("level", 1)
+        custom_model_src = self.post_process(completions)
+        print(f"[KernelBenchRewardModel] Extra info: {extra_info=}")
+        print(f"[KernelBenchRewardModel] Docker API URL: {self.docker_api_url}")
+
+        # Call Docker API instead of local evaluation
+        device = extra_info.get("device", "cuda:0")
+        print(f"[KernelBenchRewardModel] Using device {device}")
+        eval_result = eval_kernel_via_docker_api(
+            custom_model_src=custom_model_src,
+            level=extra_info.get("level", 1),
+            problem_id=extra_info.get("problem_id", 0),
+            verbose=True,
+            api_url=self.docker_api_url,
+            timeout=self.docker_api_timeout,
+            completion=completions,
+            device=device
+        )
+        
+        formatted = custom_model_src is not None
+        compiled = eval_result.compiled
+        # If the runtime error is "NoneType' object is not callable", then it means there might be undefined variables in the python network
+        if "runtime_error" in eval_result.metadata:
+            if "'NoneType' object is not callable" in eval_result.metadata["runtime_error"]:
+                compiled = False
+        correctness = eval_result.correctness
+        runtime = eval_result.runtime
+        
+        # Get baseline from loaded baseline times
+        baseline = None
+        if task_id in self.baseline_times.get(f'level{level}', {}):
+            if isinstance(self.baseline_times[f'level{level}'][task_id], dict):
+                baseline = self.baseline_times[f'level{level}'][task_id].get("mean", None)
+            else:
+                baseline = self.baseline_times[f'level{level}'][task_id]
+        eval_result.metadata["baseline"] = baseline
+
+        if baseline is None:
+            print(f"Warning: No baseline found for level {level} task_id {task_id}")
+            baseline = 1.0  # Default baseline to avoid division errors
+        
+        current_step = extra_info.get("global_steps", 0)
+        self._set_weights(current_step)
+        reward = self._compute_combined_reward(compiled, correctness, runtime, baseline)
+
+        return {
+            'score': reward,
+            'formatted_code': formatted,
+            'perf_rewards': self._compute_performance_reward(runtime, baseline),
+            'correctness_rewards': self._compute_correctness_reward(correctness),
+            'compilation_rewards': self._compute_compilation_reward(compiled),
+            'weighted_perf_rewards': self._weighted_performance_reward(runtime, baseline),
+            'weighted_correctness_rewards': self._weighted_correctness_reward(correctness),
+            'weighted_compilation_rewards': self._weighted_compilation_reward(compiled),
+            'debug_perf_weight': self.performance_weight,
+            'debug_correctness_weight': self.correctness_weight,
+            'debug_compilation_weight': self.compilation_weight,
+            'extracted_code': str(custom_model_src),
+            'metadata': eval_result.metadata
+        }
+        # prime manager
+        # return {
+        #     'score': torch.tensor(reward, dtype=torch.float32),
+        #     'reward_extra_info': {
+        #         'comb_rewards': reward,
+        #         'perf_rewards': self._compute_performance_reward(runtime, baseline),
+        #         'correctness_rewards': self._compute_correctness_reward(correctness),
+        #         'compilation_rewards': self._compute_compilation_reward(compiled),
+        #     }
+        # }
+
+    def compute_batch_rewards_from_eval_results(self, eval_results: List[Dict[str, Any]]) -> torch.Tensor:
+        """
+        Compute rewards for a batch of evaluation results.
+        
+        Args:
+            eval_results: List of evaluation result dictionaries
+            
+        Returns:
+            Tensor of reward scores
+        """
+        rewards = []
+        for eval_result in eval_results:
+            reward = self.compute_reward_from_eval_result(eval_result)
+            rewards.append(reward)
+        
+        return torch.tensor(rewards, dtype=torch.float32)
+
+    @property
+    def __name__(self):
+        return "KernelBenchRewardModel"
+
+    def get_reward_breakdown(self, eval_result: Dict[str, Any]) -> Dict[str, float]:
+        """
+        Get detailed breakdown of reward components.
+        
+        Args:
+            eval_result: Single evaluation result dictionary
+            
+        Returns:
+            Dictionary with reward breakdown
+        """
+        compiled = eval_result.get('compiled', False)
+        correctness = eval_result.get('correctness', False)
+        runtime = eval_result.get('runtime', -1.0)
+        baseline = eval_result.get('baseline', None)
+        
+        comp_reward = self._compute_compilation_reward(compiled)
+        corr_reward = self._compute_correctness_reward(correctness)
+        perf_reward = self._compute_performance_reward(runtime, baseline)
+        
+        combined_reward = (
+            self.compilation_weight * comp_reward +
+            self.correctness_weight * corr_reward +
+            self.performance_weight * perf_reward
+        )
+        
+        return {
+            'compilation_reward': comp_reward,
+            'correctness_reward': corr_reward,
+            'performance_reward': perf_reward,
+            'combined_reward': combined_reward,
+            'speedup': baseline / runtime if baseline and runtime > 0 else 0.0
+        }
+
