+from collections import defaultdict
+from dataclasses import dataclass
+from typing import Any
+import multiprocessing as mp
+import time
+
+import torch
+
+from verl import DataProto
+from verl.utils.reward_score import default_compute_score
+from verl.workers.reward_manager import register
+from verl.workers.reward_manager.abstract import AbstractRewardManager
+
+
+@dataclass
+class RewardWorkArgs:
+    """Arguments for a single reward computation task"""
+    index: int
+    prompt_str: str
+    response_str: str
+    ground_truth: Any
+    data_source: str
+    extra_info: dict
+    valid_response_length: int
+
+
+def compute_single_reward(work_args: RewardWorkArgs, reward_model_configuration, compute_score_fn) -> tuple[int, float, dict]:
+    """
+    Compute reward for a single sample on a specific GPU device
+    
+    Args:
+        work_args: RewardWorkArgs containing all necessary information
+        reward_model_configuration: Reward model configuration dictionary
+        compute_score_fn: The scoring function to use
+        
+    Returns:
+        Tuple of (index, reward, score_dict)
+    """
+    try:
+        # Set the device for this worker        
+        score = compute_score_fn(
+            data_source=work_args.data_source,
+            solution_str=work_args.response_str,
+            ground_truth=work_args.ground_truth,
+            extra_info=work_args.extra_info,
+            reward_model_configuration=reward_model_configuration,
+        )
+        
+        if isinstance(score, dict):
+            reward = score["score"]
+            return (work_args.index, reward, score)
+        else:
+            reward = score
+            return (work_args.index, reward, {"score": score})
+            
+    except Exception as e:
+        print(f"[WARNING] Error computing reward for index {work_args.index}: {str(e)}")
+        # Return a default reward on error
+        return (work_args.index, 0.0, {"score": 0.0, "error": str(e)})
+
+
+@register("batch_parallel")
+class BatchParallelRewardManager(AbstractRewardManager):
+    """
+    Reward manager that processes rewards in parallel across multiple GPU devices.
+    
+    Similar to the batch_eval approach, this manager:
+    1. Splits data into batches based on number of available GPUs
+    2. Assigns each batch item to a specific CUDA device
+    3. Processes batches in parallel using multiprocessing
+    4. Handles timeouts and errors gracefully
+    """
+
+    def __init__(
+        self, 
+        tokenizer, 
+        num_examine, 
+        compute_score=None, 
+        reward_fn_key="data_source",
+        num_gpu_devices=4,
+        timeout=180,
+        reward_model_configuration=None,
+        **kwargs
+    ) -> None:
+        """
+        Initialize the BatchParallelRewardManager instance.
+
+        Args:
+            tokenizer: The tokenizer used to decode token IDs into text.
+            num_examine: The number of batches of decoded responses to print to the console for debugging purpose.
+            compute_score: A function to compute the reward score. If None, `default_compute_score` will be used.
+            reward_fn_key: The key used to access the data source in the non-tensor batch data. Defaults to
+                "data_source".
+            num_gpu_devices: Number of GPU devices to use for parallel processing. Defaults to 4.
+            timeout: Timeout in seconds for each batch of reward computation. Defaults to 180.
+        """
+        self.tokenizer = tokenizer
+        self.num_examine = num_examine
+        self.compute_score = compute_score or default_compute_score
+        self.reward_fn_key = reward_fn_key
+        self.num_gpu_devices = num_gpu_devices
+        self.timeout = timeout
+        self.reward_model_configuration = reward_model_configuration
+
+        # Note: We don't set the multiprocessing start method here to avoid
+        # conflicts with DataLoader's multiprocessing. The training script
+        # should set it appropriately before creating any workers.
+
+    def _prepare_work_args(self, data: DataProto) -> list[RewardWorkArgs]:
+        """
+        Prepare work arguments for all data items
+        
+        Args:
+            data: DataProto containing batch data
+            
+        Returns:
+            List of RewardWorkArgs for each data item
+        """
+        work_args_list = []
+        
+        for i in range(len(data)):
+            data_item = data[i]
+            
+            prompt_ids = data_item.batch["prompts"]
+            prompt_length = prompt_ids.shape[-1]
+            
+            valid_prompt_length = data_item.batch["attention_mask"][:prompt_length].sum()
+            valid_prompt_ids = prompt_ids[-valid_prompt_length:]
+            
+            response_ids = data_item.batch["responses"]
+            valid_response_length = data_item.batch["attention_mask"][prompt_length:].sum()
+            valid_response_ids = response_ids[:valid_response_length]
+            
+            # Decode
+            prompt_str = self.tokenizer.decode(valid_prompt_ids, skip_special_tokens=True)
+            response_str = self.tokenizer.decode(valid_response_ids, skip_special_tokens=True)
+            
+            ground_truth = data_item.non_tensor_batch["reward_model"]["ground_truth"]
+            data_source = data_item.non_tensor_batch[self.reward_fn_key]
+            extra_info = data_item.non_tensor_batch.get("extra_info", {}).copy()
+            # Assign device in round-robin fashion
+            extra_info.update({"device": f"cuda:{i % self.num_gpu_devices}"})
+            num_turns = data_item.non_tensor_batch.get("__num_turns__", None)
+            rollout_reward_scores = data_item.non_tensor_batch.get("reward_scores", {})
+            global_steps = data_item.meta_info.get("global_steps", 0)
+            extra_info["global_steps"] = global_steps
+            extra_info["num_turns"] = num_turns
+            extra_info["rollout_reward_scores"] = rollout_reward_scores
+            
+            work_args = RewardWorkArgs(
+                index=i,
+                prompt_str=prompt_str,
+                response_str=response_str,
+                ground_truth=ground_truth,
+                data_source=data_source,
+                extra_info=extra_info,
+                valid_response_length=valid_response_length,
+            )
+            work_args_list.append(work_args)
+            
+        return work_args_list
+
+    def _process_batch(self, work_batch: list[RewardWorkArgs]) -> list[tuple[int, float, dict]]:
+        """
+        Process a batch of reward computations in parallel
+        
+        Args:
+            work_batch: List of RewardWorkArgs to process
+            
+        Returns:
+            List of (index, reward, score_dict) tuples
+        """
+        batch_size = len(work_batch)
+        results = []
+        
+        with mp.Pool(min(batch_size, self.num_gpu_devices)) as pool:
+            start_time = time.time()
+            
+            # Submit all work items asynchronously
+            async_results = []
+            for work_arg in work_batch:
+                print(f"[BatchParallelRewardManager] Processing work arg {work_arg.index} with {work_arg.extra_info['device']=}")
+                async_result = pool.apply_async(
+                    compute_single_reward,
+                    args=(work_arg, self.reward_model_configuration, self.compute_score)
+                )
+                async_results.append((async_result, work_arg))
+            
+            # Collect results with timeout
+            for async_result, work_arg in async_results:
+                try:
+                    elapsed_time = time.time() - start_time
+                    remaining_time = max(0, self.timeout - elapsed_time)
+                    result = async_result.get(timeout=self.timeout)
+                    results.append(result)
+                except mp.TimeoutError:
+                    print(f"[WARNING] Reward computation TIMED OUT for index {work_arg.index}")
+                    result = {
+                        "score": 0.0,
+                        "formatted_code": 0.0,
+                        "compilation_rewards": 0.0,
+                        "correctness_rewards": 0.0,
+                        "perf_rewards": 0.0,
+                        "weighted_perf_rewards": 0.0,
+                        "weighted_correctness_rewards": 0.0,
+                        "weighted_compilation_rewards": 0.0,
+                        "debug_perf_weight": 0.0,
+                        "debug_correctness_weight": 0.0,
+                        "debug_compilation_weight": 0.0,
+                        "extracted_code": "",
+                        "metadata": {'eval_error': 'Evaluation timed out due to either compilation or execution timeout.'}
+                    }
+                    results.append((work_arg.index, 0.0, result))
+                except Exception as e:
+                    print(f"[ERROR] Reward computation FAILED for index {work_arg.index}: {str(e)}")
+                    result = {
+                        "score": 0.0,
+                        "formatted_code": 0.0,
+                        "compilation_rewards": 0.0,
+                        "correctness_rewards": 0.0,
+                        "perf_rewards": 0.0,
+                        "weighted_perf_rewards": 0.0,
+                        "weighted_correctness_rewards": 0.0,
+                        "weighted_compilation_rewards": 0.0,
+                        "debug_perf_weight": 0.0,
+                        "debug_correctness_weight": 0.0,
+                        "debug_compilation_weight": 0.0,
+                        "extracted_code": "",
+                        "metadata": {'eval_error': f'Error: {str(e)}'}
+                    }
+                    results.append((work_arg.index, 0.0, result))
+        return results
+
+    def __call__(self, data: DataProto, return_dict: bool = False) -> torch.Tensor | dict[str, Any]:
+        """
+        Compute rewards for all data items in parallel across multiple GPUs
+        
+        Args:
+            data: DataProto containing batch data
+            return_dict: If True, return dictionary with reward_tensor and extra info
+            
+        Returns:
+            Reward tensor or dictionary containing rewards and extra information
+        """
+        # If there is rm score, we directly return rm score
+        if "rm_scores" in data.batch.keys():
+            if return_dict:
+                reward_extra_keys = data.meta_info.get("reward_extra_keys", [])
+                reward_extra_info = {key: data.non_tensor_batch[key] for key in reward_extra_keys}
+                return {"reward_tensor": data.batch["rm_scores"], "reward_extra_info": reward_extra_info}
+            else:
+                return data.batch["rm_scores"]
+        
+        reward_tensor = torch.zeros_like(data.batch["responses"], dtype=torch.float32)
+        reward_extra_info = defaultdict(list)
+        already_print_data_sources = {}
+        
+        # Prepare all work arguments
+        print(f"[BatchParallelRewardManager] Preparing work args for {len(data)} items")
+        all_work = self._prepare_work_args(data)
+        print(f"[BatchParallelRewardManager] Prepared work args for {len(all_work)} items, {[work_arg.extra_info['device'] for work_arg in all_work]}")
+        
+        if len(all_work) == 0:
+            if return_dict:
+                return {"reward_tensor": reward_tensor, "reward_extra_info": reward_extra_info}
+            else:
+                return reward_tensor
+        
+        # Process in batches
+        batch_size = self.num_gpu_devices
+        total_work = all_work.copy()
+        all_results = []
+        
+        print(f"[BatchParallelRewardManager] Processing {len(total_work)} items with {self.num_gpu_devices} GPUs, {batch_size=}, {[work_arg.extra_info['device'] for work_arg in all_work]}")
+        
+        while len(total_work) > 0:
+            curr_work_batch = total_work[:batch_size]
+            total_work = total_work[batch_size:]
+            
+            batch_results = self._process_batch(curr_work_batch)
+            all_results.extend(batch_results)
+        
+        # Sort results by index to maintain order
+        all_results.sort(key=lambda x: x[0])
+        
+        # Fill in reward tensor and extra info
+        for idx, reward, score_dict in all_results:
+            work_arg = all_work[idx]
+            reward_tensor[idx, work_arg.valid_response_length - 1] = reward
+            
+            # Store extra information
+            for key, value in score_dict.items():
+                reward_extra_info[key].append(value)
+            
+            # Print examples for debugging
+            data_source = work_arg.data_source
+            if data_source not in already_print_data_sources:
+                already_print_data_sources[data_source] = 0
+            
+            if already_print_data_sources[data_source] < self.num_examine:
+                already_print_data_sources[data_source] += 1
+                print(f"[prompt] {work_arg.prompt_str}")
+                print(f"[response] {work_arg.response_str}")
+                print(f"[ground_truth] {work_arg.ground_truth}")
+                for key, value in score_dict.items():
+                    print(f"[{key}] {value}")
+        
+        if return_dict:
+            return {
+                "reward_tensor": reward_tensor,
+                "reward_extra_info": reward_extra_info,
+            }
+        else:
+            return reward_tensor
+
