+class EditBenchRewardModel:
+    """
+    Reward model for KernelBench evaluation results.
+    
+    This reward function computes scores based on KernelBench evaluation results,
+    considering compilation success, correctness, and performance (speedup).
+    """
+    
+    def __init__(
+        self,
+        pretrain_compilation_weight: float = 0.5,
+        finetune_compilation_weight: float = 0.1,
+        pretrain_correctness_weight: float = 1.3, 
+        finetune_correctness_weight: float = 0.3, 
+        pretrain_performance_weight: float = 0,
+        finetune_performance_weight: float = 1,
+        baseline_time_file: str = "benchmark/KernelBench/results/timing/L40S_vegeta/baseline_time_torch.json",
+        docker_api_url: str = f"http://localhost:9000",
+        docker_api_timeout: int = 300,
+        pretrain_steps: int = 0
+    ):
+        """
+        Initialize the KernelBench reward model.
+        
+        Args:
+            compilation_weight: Weight for compilation success (0-1)
+            correctness_weight: Weight for correctness (0-1) 
+            performance_weight: Weight for performance/speedup (0-1)
+            baseline_time_file: Path to baseline timing file
+            docker_api_url: URL of the Docker API service
+            docker_api_timeout: Request timeout in seconds
+        """
+            
+        self.code_language_types = ["python", "cpp"]
+        self.pretrain_compilation_weight = pretrain_compilation_weight
+        self.pretrain_correctness_weight = pretrain_correctness_weight
+        self.pretrain_performance_weight = pretrain_performance_weight
+        self.finetune_compilation_weight = finetune_compilation_weight
+        self.finetune_correctness_weight = finetune_correctness_weight
+        self.finetune_performance_weight = finetune_performance_weight
+        self.compilation_weight = self.pretrain_compilation_weight
+        self.correctness_weight = self.pretrain_correctness_weight
+        self.performance_weight = self.pretrain_performance_weight
+        self.pretrain_steps = pretrain_steps
