+from .semrep_editing_rewards import ExecutionTimeRewardModel
+from .semrep_editing_rewards import EditBenchRewardModel
+from .semrep_editing_rewards import KernelBenchRewardModel
+
+def compute_score(solution_str, ground_truth, extra_info=None, reward_model_configuration=None):
+    """
+    VERL-compatible wrapper that uses get_reward_func to get the appropriate reward function.
+    
+    Args:
+        data_source: Dataset source identifier (not used)
+        solution_str: Generated code solution
+        ground_truth: Ground truth or problem ID
+        extra_info: Additional information (can contain problem_id)
+        reward_func_name: Name of the reward function to use
+    
+    Returns:
+        Reward score (float)
+    """
+    
+    try:
+        # Handle execution time reward
+        reward_func_name = reward_model_configuration.get("reward_func_name", "kernelbench")
+        print(f"[CodeEditingRewardModel] Reward function name: {reward_func_name}")
+        if reward_func_name == "kernelbench":
+            reward_model = KernelBenchRewardModel(
+                **reward_model_configuration
+            )
+        elif reward_func_name == "editbench":
+            reward_model = EditBenchRewardModel(
+                **reward_model_configuration
+            )
+        elif reward_func_name == "execution_time":
+            reward_model = ExecutionTimeRewardModel(
+                **reward_model_configuration
+            )
+        else:
+            raise ValueError(f"Unknown reward function: {reward_func_name}")
+        
+        try:
+            reward_dict = reward_model(
+                solution_str, 
+                ground_truth,
+                extra_info=extra_info
+            )
+        except Exception as e:
+            reward_dict = {
+                "score": 0.0,
+                "formatted_code": 0.0,
+                "compilation_rewards": 0.0,
+                "correctness_rewards": 0.0,
+                "perf_rewards": 0.0,
+                "weighted_perf_rewards": 0.0,
+                "weighted_correctness_rewards": 0.0,
+                "weighted_compilation_rewards": 0.0,
+                "debug_perf_weight": 0.0,
+                "debug_correctness_weight": 0.0,
+                "debug_compilation_weight": 0.0,
+                "extracted_code": "",
+                "metadata": {'eval_error': f'Error: {str(e)}'}
+            }
+        # reward_dict["extra_info"] = extra_info
+        
+        return reward_dict
+                
+    except Exception as e:
+        print(f"Error computing reward with {reward_func_name}: {e}")
+        # print the stack trace
+        import traceback
+        print(traceback.format_exc())
+        # Return a default negative reward on error
+        return -1.0
