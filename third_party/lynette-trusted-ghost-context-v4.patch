+// Keep the context of existing trust calls, including in erased proof code.
+struct FindTrustedCall(bool);
+impl VisitMut for FindTrustedCall {
+    fn visit_expr_mut(&mut self, expr: &mut syn_verus::Expr) {
+        self.0 |= matches!(expr, syn_verus::Expr::Assume(_))
