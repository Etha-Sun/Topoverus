+// Reading a Boolean variable or literal cannot mutate state or panic.
+// Keep calls, arithmetic, indexing and other condition expressions intact.
+fn trivial_condition(expr: &syn_verus::Expr) -> bool {
+    match expr {
+        syn_verus::Expr::Path(p) => p.attrs.is_empty() && p.qself.is_none()
+            && p.path.leading_colon.is_none() && p.path.segments.len() == 1
+            && matches!(p.path.segments[0].arguments, syn_verus::PathArguments::None),
+        syn_verus::Expr::Lit(l) => l.attrs.is_empty() && matches!(l.lit, syn_verus::Lit::Bool(_)),
+        syn_verus::Expr::Paren(p) => p.attrs.is_empty() && trivial_condition(&p.expr),
+        _ => false,
+    }
+}
 
