+// Plain assertions add verified obligations; they do not alter trust context.
+// Keep bindings, assignments, guards and assertion proof bodies unchanged.
+struct ErasePlainAssertions;
+impl VisitMut for ErasePlainAssertions {
+    fn visit_block_mut(&mut self, block: &mut syn_verus::Block) {
+        block.stmts.retain(|stmt| !matches!(stmt,
+            syn_verus::Stmt::Expr(syn_verus::Expr::Assert(a), _) if a.body.is_none() && !trusted_expr(&syn_verus::Expr::Assert(a.clone()))));
+        visit_mut::visit_block_mut(self, block);
+    }
+}
+fn trusted_body(block: &syn_verus::Block) -> syn_verus::Block {
+    let mut result = block.clone();
